{
  "format": "fsharpened.language/1",
  "id": "elixir",
  "name": "Elixir",
  "extensions": [
    ".ex",
    ".exs"
  ],
  "scope": "source.elixir",
  "comments": {
    "line": "#"
  },
  "indent": {
    "tabs": false,
    "size": 2
  },
  "server": {
    "command": "elixir-ls",
    "args": [],
    "install": "https://github.com/elixir-lsp/elixir-ls"
  },
  "tools": [
    {
      "id": "elixir",
      "label": "Elixir",
      "candidates": [
        [
          "elixir"
        ]
      ],
      "version": [
        "--version"
      ],
      "install": "https://elixir-lang.org/install.html"
    }
  ],
  "run": [
    {
      "steps": [
        {
          "phase": "run",
          "tool": "elixir",
          "args": [
            "{entry}"
          ]
        }
      ]
    }
  ]
}
