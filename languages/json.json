{
  "format": "fsharpened.language/1",
  "id": "json",
  "name": "JSON",
  "extensions": [
    ".json",
    ".jsonc",
    ".code-workspace"
  ],
  "scope": "source.json",
  "indent": {
    "tabs": false,
    "size": 2
  },
  "server": {
    "command": "vscode-json-language-server",
    "args": [
      "--stdio"
    ],
    "install": "npm install -g vscode-langservers-extracted"
  }
}
