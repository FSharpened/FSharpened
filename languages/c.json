{
  "format": "fsharpened.language/1",
  "id": "c",
  "name": "C",
  "extensions": [
    ".c",
    ".h"
  ],
  "scope": "source.c",
  "comments": {
    "line": "//",
    "block": [
      "/*",
      "*/"
    ]
  },
  "indent": {
    "tabs": false,
    "size": 4
  },
  "server": {
    "command": "clangd",
    "args": [],
    "install": "install clangd (LLVM)"
  },
  "tools": [
    {
      "id": "cc",
      "label": "C compiler",
      "candidates": [
        [
          "gcc"
        ],
        [
          "clang"
        ],
        [
          "cc"
        ]
      ],
      "version": [
        "--version"
      ],
      "install": "install gcc or clang"
    },
    {
      "id": "clang-format",
      "label": "clang-format",
      "candidates": [
        [
          "clang-format"
        ]
      ],
      "version": [
        "--version"
      ],
      "install": "install clang-format"
    }
  ],
  "run": [
    {
      "steps": [
        {
          "phase": "build",
          "tool": "cc",
          "args": [
            "{entry}",
            "-o",
            "{out}",
            "{flags}"
          ]
        },
        {
          "phase": "run",
          "tool": "built",
          "args": []
        }
      ]
    }
  ],
  "formatter": {
    "phase": "run",
    "tool": "clang-format",
    "args": [
      "-i",
      "{entry}"
    ]
  },
  "debug": {
    "adapter": "lldb-dap",
    "args": [],
    "install": "install LLVM, which includes lldb-dap: https://github.com/llvm/llvm-project/releases",
    "adapterId": "lldb-dap",
    "request": "launch",
    "build": {
      "phase": "build",
      "tool": "cc",
      "args": [
        "-g",
        "{entry}",
        "-o",
        "{out}",
        "{flags}"
      ]
    },
    "launch": {
      "program": "{out}",
      "cwd": "{root}",
      "args": [],
      "stopOnEntry": false
    }
  }
}
