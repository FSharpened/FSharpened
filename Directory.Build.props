<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Runs on the net8.0 runtime when present, otherwise rolls forward (e.g. SDK-only 9.x machines, CI). -->
    <RollForward>LatestMajor</RollForward>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <OtherFlags>$(OtherFlags) --warnon:3390</OtherFlags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>The FSharpened contributors</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Company>FSharpened</Company>
    <Product>FSharpened</Product>
    <Copyright>Copyright 2026 The FSharpened contributors</Copyright>
    <PackageReadmeFile Condition="Exists('$(MSBuildThisFileDirectory)README.md')">README.md</PackageReadmeFile>
    <Version>0.0.1-skeleton</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The F# SDK disables its implicit FSharp.Core reference under central package management,
         so reference it explicitly. Version is pinned in Directory.Packages.props. -->
    <PackageReference Include="FSharp.Core" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
  </ItemGroup>

  <ItemGroup>
    <!-- GHSA-p3jp-9v83-76w9 affects Microsoft.DotNet.ILCompiler 8.0.x (build-time NativeAOT compiler; never shipped,
         never fed untrusted input). Suppressed narrowly by advisory URL, approved by the maintainer 2026-11-16.
         Remove once the pinned ILCompiler moves past the fixed version. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-p3jp-9v83-76w9" />
  </ItemGroup>
</Project>
