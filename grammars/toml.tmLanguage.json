{
  "name": "TOML",
  "scopeName": "source.toml",
  "fileTypes": ["toml"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#table" },
    { "include": "#key" },
    { "include": "#value" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.toml",
      "match": "#.*$"
    },
    "table": {
      "name": "entity.name.section.toml",
      "match": "^\\s*\\[\\[?[^\\]\\n]+\\]\\]?"
    },
    "key": {
      "name": "variable.other.key.toml",
      "match": "^\\s*([A-Za-z0-9_-]+|\"[^\"\\n]*\"|'[^'\\n]*')(\\s*\\.\\s*([A-Za-z0-9_-]+|\"[^\"\\n]*\"|'[^'\\n]*'))*(?=\\s*=)"
    },
    "value": {
      "patterns": [
        { "include": "#comment" },
        {
          "name": "string.quoted.triple.basic.toml",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "name": "constant.character.escape.toml", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.triple.literal.toml",
          "begin": "'''",
          "end": "'''"
        },
        {
          "name": "string.quoted.double.toml",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.toml", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.toml",
          "match": "'[^'\\n]*'"
        },
        {
          "name": "constant.numeric.date.toml",
          "match": "\\b[0-9]{4}-[0-9]{2}-[0-9]{2}([Tt ][0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([Zz]|[+-][0-9]{2}:[0-9]{2})?)?\\b|\\b[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.toml",
          "match": "[+-]?\\b(0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9_]+)?)\\b|[+-]?\\b(inf|nan)\\b"
        },
        {
          "name": "constant.language.boolean.toml",
          "match": "\\b(true|false)\\b"
        }
      ]
    }
  }
}
