<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FSharpened.Ide.Desktop</AssemblyName>
    <Description>The FSharpened desktop IDE (ADR-0023): a native Avalonia window in F# over the same core as the website IDE.</Description>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Ext.fs" />
    <Compile Include="Access.fs" />
    <Compile Include="Palette.fs" />
    <Compile Include="Session.fs" />
    <Compile Include="Hover.fs" />
    <Compile Include="DebugView.fs" />
    <Compile Include="Grammars.fs" />
    <Compile Include="TerminalView.fs" />
    <Compile Include="Dialogs.fs" />
    <Compile Include="Gutter.fs" />
    <Compile Include="Model.fs" />
    <Compile Include="Decisions.fs" />
    <Compile Include="Ui.fs" />
    <Compile Include="Appearance.fs" />
    <Compile Include="StatusBar.fs" />
    <Compile Include="Problems.fs" />
    <Compile Include="TerminalPanel.fs" />
    <Compile Include="LanguageServers.fs" />
    <Compile Include="HoverPanel.fs" />
    <Compile Include="EditorTabs.fs" />
    <Compile Include="RunPanel.fs" />
    <Compile Include="RenameFeature.fs" />
    <Compile Include="DebugPanel.fs" />
    <Compile Include="Explorer.fs" />
    <Compile Include="SidebarViews.fs" />
    <Compile Include="FolderSession.fs" />
    <Compile Include="Commands.fs" />
    <Compile Include="CommandPalette.fs" />
    <Compile Include="Menus.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="Wiring.fs" />
    <Compile Include="MainWindow.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="TextMateSharp.Grammars" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharpened.Ide\FSharpened.Ide.fsproj" />
    <ProjectReference Include="..\FSharpened.Ide.Host\FSharpened.Ide.Host.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Language packs ship next to the program; the user's own go in the app data folder. -->
    <Content Include="..\..\languages\*.json" Link="languages\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\grammars\*.json" Link="grammars\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
