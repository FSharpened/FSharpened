<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Host services of the FSharpened desktop IDE (ADR-0023): language packs, run plans, the local runner, project trust, tool probes and the workspace on disk. No UI reference, so everything that can touch the machine is tested without a window.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="LanguagePack.fs" />
    <Compile Include="Proc.fs" />
    <Compile Include="Tools.fs" />
    <Compile Include="Plans.fs" />
    <Compile Include="Trust.fs" />
    <Compile Include="DiskWorkspace.fs" />
    <Compile Include="Replace.fs" />
    <Compile Include="NativeLib.fs" />
    <Compile Include="FolderSearch.fs" />
    <Compile Include="FolderWatch.fs" />
    <Compile Include="Terminal.fs" />
    <Compile Include="Git.fs" />
    <Compile Include="Lsp.fs" />
    <Compile Include="Interpret.fs" />
    <Compile Include="Runner.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSharpened.Ide\FSharpened.Ide.fsproj" />
    <ProjectReference Include="..\..\src\FSharpened.Platform\FSharpened.Platform.fsproj" />
    <ProjectReference Include="..\..\src\FSharpened.Interop.Rust\FSharpened.Interop.Rust.fsproj" />
  </ItemGroup>

  <!-- The Rust library for file watching and search (native/rust/fsh-watch, PLAN P7.8). When cargo is on the PATH it is
       built with the release profile and copied next to the program as runtimes/<rid>/native/<file>, the layout the
       Interop.Rust resolver reads and `dotnet publish` carries along. Without cargo nothing happens: the IDE then
       uses its managed search and a polling watcher. Set FshSkipRust=true to skip the build even when cargo exists. -->
  <PropertyGroup>
    <FshWatchDir>$(MSBuildThisFileDirectory)../../native/rust/fsh-watch/</FshWatchDir>
    <FshWatchRelease>$(FshWatchDir)target/release/</FshWatchRelease>
  </PropertyGroup>

  <Target Name="BuildFshWatch" BeforeTargets="AssignTargetPaths" Condition="'$(FshSkipRust)' != 'true' and Exists('$(FshWatchDir)Cargo.toml')">
    <Exec Command="cargo --version" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="FshCargoProbe" />
    </Exec>
    <Exec Condition="'$(FshCargoProbe)' == '0'" Command="cargo build --release --locked --manifest-path &quot;$(FshWatchDir)Cargo.toml&quot;" StandardOutputImportance="low" />
    <ItemGroup Condition="'$(FshCargoProbe)' == '0'">
      <FshWatchLibrary Include="$(FshWatchRelease)fsh_watch.dll;$(FshWatchRelease)libfsh_watch.so;$(FshWatchRelease)libfsh_watch.dylib" />
      <None Include="@(FshWatchLibrary)" Condition="Exists('%(FullPath)')" Link="runtimes/$(NETCoreSdkRuntimeIdentifier)/native/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
