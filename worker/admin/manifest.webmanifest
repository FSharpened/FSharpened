{
  "id": "/",
  "name": "FSharpened Hub",
  "short_name": "Hub",
  "description": "Admin console for the FSharpened CI hub: pipeline runs, platform matrix, tokens and settings.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "theme_color": "#4338ca",
  "background_color": "#0b1020",
  "lang": "en",
  "dir": "ltr",
  "categories": ["developer", "productivity", "utilities"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Pipeline runs", "short_name": "Runs", "description": "Every run published to the hub", "url": "/?source=shortcut#/runs", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Stage performance", "short_name": "Stages", "description": "Stage timings and regressions", "url": "/?source=shortcut#/stages", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "API tokens", "short_name": "Tokens", "description": "Create or revoke publisher tokens", "url": "/?source=shortcut#/tokens", "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
