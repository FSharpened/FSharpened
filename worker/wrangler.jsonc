{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fsharpened-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./admin",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "fsharpened-hub", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [ { "binding": "SETTINGS", "id": "00000000000000000000000000000000" } ],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "RETENTION_DAYS": "180"
  }
}
